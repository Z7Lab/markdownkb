# MarkdownKB environment configuration
# Copy to .env and adjust as needed: cp .env.example .env

# ── Server ────────────────────────────────────────
API_PORT=9713
FRONTEND_PORT=9714

# ── Docker ────────────────────────────────────────
MARKDOWNKB_CONTAINER=markdownkb
MARKDOWNKB_PORT=9713
# Bind address (Docker only): localhost by default.
# Uncomment to allow access from other machines on your network.
# If you do, also set MARKDOWNKB_API_KEY below to protect the API.
# MARKDOWNKB_HOST=0.0.0.0

# MCP server bind address: localhost by default.
# Set to 0.0.0.0 if agents in Docker containers need to reach MCP
# via host.docker.internal. Also add "host.docker.internal:*" to
# mcp.allowed_hosts in settings.yaml.
# MARKDOWNKB_MCP_HOST=0.0.0.0

# ── LLM Providers ────────────────────────────────
# Ollama remote server — set this if Ollama runs on a different machine.
# See docs/ollama-remote-setup.md for secure setup instructions.
# OLLAMA_API_BASE=http://192.168.x.x:11434

# API keys: set here or in secrets/<provider>_api_key files.
# Docker secrets take priority; env vars are the fallback.
# Note: env vars are visible in `docker inspect` — use secrets/ files
# instead if others have Docker access on this host.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VENICE_API_KEY=

# ── Authentication ──────────────────────────────
# Set a key to protect all /api/ endpoints (optional).
# When empty or unset, authentication is disabled.
# Pick any string, or generate one:  openssl rand -hex 16
# MARKDOWNKB_API_KEY=
