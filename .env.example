# mdkb environment configuration
# Copy to .env and adjust as needed: cp .env.example .env

# ── Server ────────────────────────────────────────
API_PORT=9713
FRONTEND_PORT=9714

# ── Docker ────────────────────────────────────────
MDKB_CONTAINER=mdkb
MDKB_PORT=9713
# Bind address: 127.0.0.1 = localhost only (default, secure)
# Set to 0.0.0.0 to expose to your network (use with caution)
# MDKB_HOST=127.0.0.1

# ── LLM Providers ────────────────────────────────
# Ollama remote server — set this if Ollama runs on a different machine.
# See docs/ollama-remote-setup.md for secure setup instructions.
# OLLAMA_API_BASE=http://192.168.x.x:11434

# API keys (optional — only needed if using cloud providers)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
