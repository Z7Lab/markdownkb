# MarkdownKB environment configuration
# Copy to .env and adjust as needed: cp .env.example .env

# ── Server ────────────────────────────────────────
API_PORT=9713
FRONTEND_PORT=9714

# ── Docker ────────────────────────────────────────
MARKDOWNKB_CONTAINER=markdownkb

# Host-facing ports for the web UI/API and the MCP endpoint.
# These remap the external port only — the container always listens on
# 9713 (app) and 9715 (MCP) internally. Change these if 9713/9715 are
# already in use on your machine.
MARKDOWNKB_PORT=9713
MARKDOWNKB_MCP_PORT=9715

# Source directory mounts: the UI auto-generates config/compose.override.yml
# when you add sources or project roots via Settings.
#
# compose.override.yml (root) is yours to edit — add extra environment
# variables, custom volume mounts, or other service overrides here.
# It supports ${VAR} substitution: any variable defined in this .env file
# (or exported in your shell) is expanded by Docker Compose at startup.
# Example:
#   services:
#     markdownkb:
#       environment:
#         - MY_EXTRA_VAR=${MY_EXTRA_VAR}
COMPOSE_FILE=compose.yml:compose.override.yml:config/compose.override.yml

# Bind address: who can reach the web UI and API.
#   127.0.0.1  = this machine only (secure default)
#   0.0.0.0    = any machine on your network (http://<hostname>.local:9713)
# If you access from another computer, phone, or tablet — use 0.0.0.0.
# Do NOT change back to 127.0.0.1 unless you only use localhost.
# SERVER_HOST=0.0.0.0

# MCP server bind address: who can reach the MCP tools endpoint.
#   127.0.0.1      = this machine only (default, safest)
#   0.0.0.0        = any machine on your network
#   192.168.x.x    = only that specific interface — tightest LAN binding
# If agents on other machines or in Docker containers need MCP — use 0.0.0.0
# (or a specific LAN IP).  The default Host-header allowlist already includes
# localhost, host.docker.internal, your hostname, and your LAN IPs, so most
# clients work without touching mcp.allowed_hosts in settings.yaml.
# MARKDOWNKB_MCP_HOST=0.0.0.0

# ── LLM Providers ────────────────────────────────
# API keys: use secrets/<provider>_api_key files (preferred).
# Or paste keys in the Settings UI — they're saved to the secrets directory.
# Env vars below are a fallback but visible in `docker inspect`.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VENICE_API_KEY=

# Ollama remote server — set if Ollama runs on a different machine.
# OLLAMA_API_BASE=http://192.168.x.x:11434

# ── Authentication ──────────────────────────────
# Protect all /api/ endpoints with an API key (recommended when using 0.0.0.0).
# Generate from the UI (setup banner) or set manually:
#   openssl rand -hex 16 > secrets/markdownkb_api_key
# MARKDOWNKB_API_KEY=
