# compose.override.yml — user-managed service overrides.
#
# Copy this file:  cp compose.override.yml.example compose.override.yml
#
# Source directory mounts are handled automatically when you add sources
# via the Settings UI — they are written to config/compose.override.yml.
#
# Use this file for:
#   - Extra environment variables  (supports ${VAR} substitution from .env)
#   - Custom volume mounts not covered by auto-generation
#   - Port overrides or other service tweaks
#
# Example — expose an extra env var:
#   services:
#     markdownkb:
#       environment:
#         - MY_EXTRA_VAR=${MY_EXTRA_VAR}
#
# After changing this file: make docker-down && make docker-up

services:
  markdownkb:
    volumes: []

  markdownkb-mcp:
    volumes: []
