# mdkb configuration — copy this file to settings.yaml and edit as needed:
#   cp config/settings.yaml.example config/settings.yaml

# Directories to watch for markdown files
sources:
- ./docs

# Project roots — auto-discover docs in cloned repositories
# Each entry scans immediate subdirectories for files matching include patterns.
# New repos cloned into the root are picked up automatically (~60s).
# project_roots:
# - path: /home/user/projects
#   include:
#     - '*.md'              # Root-level markdown (README, etc.)
#     - 'docs/**/*.md'      # Everything under docs/
#   exclude:
#     - 'CHANGELOG.md'
#     - 'LICENSE.md'

# Glob patterns to skip during file scanning
global_ignore:
- '**/node_modules/**'
- '**/.git/**'
- '**/.venv/**'
- '**/__pycache__/**'
- '**/build/**'
- '**/dist/**'

# Embedding model settings (ONNX, runs locally on CPU)
embeddings:
  model: all-MiniLM-L6-v2
  chunk_size: 1500       # ~375-500 tokens; use 512 chars for small corpora
  chunk_overlap: 150     # 10% overlap for context continuity

  # Available models — the active model is auto-downloaded on first startup.
  # Add your own ONNX sentence-transformer models here.
  # Required fields: model_id, display_name, huggingface_repo, dimensions, max_seq_length
  # Optional: description, query_prefix, local_path, onnx_path, tokenizer_path, files
  models:
  - model_id: all-MiniLM-L6-v2
    display_name: MiniLM L6 v2
    huggingface_repo: sentence-transformers/all-MiniLM-L6-v2
    dimensions: 384
    max_seq_length: 256
    description: 'Fast, lightweight (23MB). Good general purpose.'
  - model_id: all-MiniLM-L12-v2
    display_name: MiniLM L12 v2
    huggingface_repo: sentence-transformers/all-MiniLM-L12-v2
    dimensions: 384
    max_seq_length: 256
    description: 'Higher quality than L6, slightly slower (33MB).'
  - model_id: bge-small-en-v1.5
    display_name: BGE Small EN v1.5
    huggingface_repo: BAAI/bge-small-en-v1.5
    dimensions: 384
    max_seq_length: 512
    description: 'Best retrieval quality (33MB). Longer context.'
    query_prefix: 'Represent this sentence for searching relevant passages: '

  # Example: custom model from HuggingFace
  # - model_id: my-custom-model
  #   display_name: My Custom Model
  #   huggingface_repo: username/my-onnx-model
  #   dimensions: 768
  #   max_seq_length: 512
  #   description: 'My fine-tuned model'

  # Example: model from a local directory (no network download)
  # - model_id: my-local-model
  #   display_name: My Local Model
  #   huggingface_repo: username/model-name  # still needed for metadata
  #   dimensions: 384
  #   max_seq_length: 256
  #   local_path: /path/to/model/directory  # must contain onnx/model.onnx, tokenizer.json, etc.

# LLM provider configuration
# Model names use the format: provider/model (e.g. ollama/qwen3:8b, anthropic/claude-sonnet-4-20250514)
# API keys: store in secrets/<provider>_api_key (Docker secrets) or set <PROVIDER>_API_KEY env var.
#   Keys are NEVER read from this file — they are fully externalized.
#   Providers without a key are skipped (except Ollama which doesn't need one).
# Generation params (temperature, max_tokens, num_ctx) are per-provider.
# Global defaults under llm.temperature / llm.max_tokens apply when a
# provider doesn't have its own value set.
llm:
  providers:
  - name: anthropic
    model: anthropic/claude-3-5-sonnet-20241022
    api_base: ''
    temperature: 0.3
    max_tokens: 4096
  - name: openai
    model: openai/gpt-4
    api_base: ''
    temperature: 0.3
    max_tokens: 4096
  - name: ollama
    model: ollama/qwen3:8b
    api_base: http://host.docker.internal:11434  # Use localhost:11434 if running without Docker
    temperature: 0.3
    max_tokens: 4096
    num_ctx: 32768  # Ollama context window override (default: model's built-in limit)
  # Venice.ai — privacy-preserving OpenAI-compatible API (no data retention)
  # Good for RAG: deepseek-v3.2 (value), kimi-k2-5 (flagship), qwen3-235b (budget)
  - name: venice
    model: openai/deepseek-v3.2
    api_base: https://api.venice.ai/api/v1
    temperature: 0.3
    max_tokens: 16384  # Venice models support 4K-65K output depending on model
  active_provider: ollama
  temperature: 0.3   # Global default (used when provider has no temperature set)
  max_tokens: 2048   # Global default (used when provider has no max_tokens set)

# Semantic search tuning
retrieval:
  top_k: 5
  score_threshold: 0.3  # Filter weak semantic matches (0.0-1.0, higher = stricter)
  hybrid_search: true   # Combine vector similarity + BM25 keyword matching
  bm25_weight: 0.5      # Balance between keywords (0.5) and semantics (0.5)
  intelligent_search:   # LLM-powered query enhancement (requires active LLM)
    enabled: false      # Use LLM to extract keywords, expand acronyms, etc.
    extract_keywords: true
    expand_acronyms: true

# Vector store persistence directory and collection name
storage:
  persist_directory: ./data/chromadb
  collection_name: mdkb

# Core behaviour toggles (not plugins — these control built-in behaviour)
core:
  rag_chat: true
  file_watcher: true
  rate_limiting: false
  deep_research: false
  agent_skills: false
  diagnostics: false

# MCP tool enable flags
mcp:
  read_only: true       # disable all write tools (save_document, index_file) regardless
                        # of individual flags. Set to false only if you trust MCP clients
                        # to write to your knowledge base.
  filesystem: false
  terminal: false
  save_document: false  # allow MCP clients to write markdown files

# Plugins — each plugin has `enabled` plus its own config in one place.
# Builtin plugins live in app/plugins/<name>/; external plugins in data/plugins/<name>/.
# Install external plugins via POST /api/plugins/install or the Settings UI.
plugins:
  search:
    enabled: true
    chunk_multiplier: 10            # Chunks fetched per result (higher = more file diversity)
    exact_phrase_multiplier: 20     # Chunk multiplier when quoted phrases are used
    exact_phrase_matching: true     # Enable/disable quoted phrase exact matching
  export:
    enabled: true
  tags:
    enabled: true
    ai_generation: false            # AI-powered tag generation (LLM-based)
  graph:
    enabled: true
  planner:
    enabled: false
  write_api:
    enabled: false
  buckets:
    enabled: false
  catalogs:
    enabled: true

# Shared service configuration (used by multiple plugins/features)
services:
  deep_research:
    iterations: 3                   # MCTS iterations (more = deeper, slower; 1-20)
    n_approaches: 3                 # Research angles to explore (more = broader)

# UI defaults
ui:
  file_list_limit: 5000  # Max files returned in file listings (increase for large knowledge bases)

# MCP Tool Configuration
# Each MCP tool has a default config in app/mcp/<tool>/config.yaml.
# When you change MCP settings via the Settings UI, overrides are saved to
# config/mcp/<tool>.yaml (created automatically on first save).

# Logging level for UI log viewer (INFO or DEBUG)
logging:
  level: INFO

# API key authentication — protects all /api/ endpoints (except /api/health).
# Keys are resolved from Docker secrets or env vars, NOT from this file:
#   1. secrets/mdkb_api_key (Docker secret — preferred)
#   2. MDKB_API_KEY env var (fallback)
# When no key is configured and the server is network-exposed (0.0.0.0),
# the web UI shows a setup banner to generate a key with one click.

# Server binding — change host to 0.0.0.0 to allow external access
server:
  host: 127.0.0.1
  port: 9713

# Directory where saved plans (from chat) are written as markdown files
plans:
  save_directory: ./data/plans
