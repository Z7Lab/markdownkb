# mdkb configuration — copy this file to settings.yaml and edit as needed:
#   cp config/settings.yaml.example config/settings.yaml

# Directories to watch for markdown files
sources:
- ./docs

# Glob patterns to skip during file scanning
global_ignore:
- '**/node_modules/**'
- '**/.git/**'
- '**/.venv/**'
- '**/__pycache__/**'
- '**/build/**'
- '**/dist/**'

# Embedding model settings (ONNX, runs locally on CPU)
embeddings:
  model: all-MiniLM-L6-v2
  chunk_size: 512
  chunk_overlap: 50

  # Available models — the active model is auto-downloaded on first startup.
  # Add your own ONNX sentence-transformer models here.
  # Required fields: model_id, display_name, huggingface_repo, dimensions, max_seq_length
  # Optional: description, query_prefix, local_path, onnx_path, tokenizer_path, files
  models:
  - model_id: all-MiniLM-L6-v2
    display_name: MiniLM L6 v2
    huggingface_repo: sentence-transformers/all-MiniLM-L6-v2
    dimensions: 384
    max_seq_length: 256
    description: 'Fast, lightweight (23MB). Good general purpose.'
  - model_id: all-MiniLM-L12-v2
    display_name: MiniLM L12 v2
    huggingface_repo: sentence-transformers/all-MiniLM-L12-v2
    dimensions: 384
    max_seq_length: 256
    description: 'Higher quality than L6, slightly slower (33MB).'
  - model_id: bge-small-en-v1.5
    display_name: BGE Small EN v1.5
    huggingface_repo: BAAI/bge-small-en-v1.5
    dimensions: 384
    max_seq_length: 512
    description: 'Best retrieval quality (33MB). Longer context.'
    query_prefix: 'Represent this sentence for searching relevant passages: '

  # Example: custom model from HuggingFace
  # - model_id: my-custom-model
  #   display_name: My Custom Model
  #   huggingface_repo: username/my-onnx-model
  #   dimensions: 768
  #   max_seq_length: 512
  #   description: 'My fine-tuned model'

  # Example: model from a local directory (no network download)
  # - model_id: my-local-model
  #   display_name: My Local Model
  #   huggingface_repo: username/model-name  # still needed for metadata
  #   dimensions: 384
  #   max_seq_length: 256
  #   local_path: /path/to/model/directory  # must contain onnx/model.onnx, tokenizer.json, etc.

# LLM provider configuration
# Model names use LiteLLM format: provider/model
# Providers without an api_key are skipped (except Ollama)
llm:
  providers:
  - name: anthropic
    model: anthropic/claude-3-5-sonnet-20241022
    api_key: ''
    api_base: ''
  - name: openai
    model: openai/gpt-4
    api_key: ''
    api_base: ''
  - name: ollama
    model: ollama/qwen3:8b
    api_key: ''
    api_base: http://localhost:11434
  active_provider: ollama
  temperature: 0.3
  max_tokens: 2048

# Semantic search tuning
retrieval:
  top_k: 5
  score_threshold: 0.3  # Filter weak semantic matches (0.0-1.0, higher = stricter)
  hybrid_search: true   # Combine vector similarity + BM25 keyword matching
  bm25_weight: 0.5      # Balance between keywords (0.5) and semantics (0.5)
  intelligent_search:   # LLM-powered query enhancement (requires active LLM)
    enabled: false      # Use LLM to extract keywords, expand acronyms, etc.
    extract_keywords: true
    expand_acronyms: true

# Vector store persistence directory and collection name
storage:
  persist_directory: ./data/chromadb
  collection_name: mdkb

# Feature flags — toggle optional modules on/off
features:
  rag_chat: true
  file_watcher: true
  mcp_filesystem: false
  mcp_terminal: false
  mcp_tag_generator: false
  mcts_planner: false
  agent_skills: false
  write_api: false
  diagnostics: false
  rate_limiting: false

# MCP Tool Configuration
# Each MCP tool has a default config in app/mcp/<tool>/config.yaml.
# When you change MCP settings via the Settings UI, overrides are saved to
# config/mcp/<tool>.yaml (created automatically on first save).

# Logging level for UI log viewer (INFO or DEBUG)
logging:
  level: INFO

# API key authentication — set a key to protect all /api/ endpoints.
# When empty, authentication is disabled (single-user / local mode).
# Can also be set via MDKB_API_KEY environment variable.
auth:
  api_key: ''

# Server binding — change host to 0.0.0.0 to allow external access
server:
  host: 127.0.0.1
  port: 9713

# Directory where saved plans (from chat) are written as markdown files
plans:
  save_directory: ./data/plans
